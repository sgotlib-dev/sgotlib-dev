      "source": [
        "import numpy as np\n",
        "from sklearn.ensemble import RandomForestClassifier\n",
        "from xgboost import XGBRegressor\n",
        "from sklearn.metrics import roc_auc_score, classification_report\n",
        "\n",
        "# 1. Base Model: Random Forest\n",
        "# We use the tuned parameters from Experiment 1/2\n",
        "print(\"Step 1: Training Base Random Forest...\")\n",
        "rf_base = RandomForestClassifier(**grid_rf.best_params_, class_weight='balanced', random_state=42, n_jobs=-1)\n",
        "rf_base.fit(X_train, y_train)\n",
        "\n",
        "# 2. Generate Residuals\n",
        "# Residual = Actual Target - Predicted Probability\n",
        "base_probs_train = rf_base.predict_proba(X_train)[:, 1]\n",
        "residuals_train = y_train - base_probs_train\n",
        "\n",
        "# 3. Corrector Model: XGBoost Regressor (to predict the continuous residual)\n",
        "print(\"Step 2: Training XGBoost Corrector on Residuals...\")\n",
        "xgb_corrector = XGBRegressor(\n",
        "    n_estimators=100,\n",
        "    learning_rate=0.05,\n",
        "    max_depth=4,\n",
        "    random_state=42\n",
        ")\n",
        "xgb_corrector.fit(X_train, residuals_train)\n",
        "\n",
        "# 4. Ensemble Prediction on Test Set\n",
        "print(\"Step 3: Evaluating Ensemble...\")\n",
        "base_probs_test = rf_base.predict_proba(X_test)[:, 1]\n",
        "predicted_residuals = xgb_corrector.predict(X_test)\n",
        "\n",
        "# Final score = Base Probability + Predicted Correction\n",
        "ensemble_scores = base_probs_test + predicted_residuals\n",
        "# Clip scores to [0, 1] range\n",
        "ensemble_scores = np.clip(ensemble_scores, 0, 1)\n",
        "\n",
        "# 5. Performance Report\n",
        "auc_ensemble = roc_auc_score(y_test, ensemble_scores)\n",
        "print(f\"\\nEnsemble ROC-AUC: {auc_ensemble:.4f}\")\n",
        "\n",
        "# Threshold at 0.5 for classification report\n",
        "ensemble_preds = (ensemble_scores > 0.5).astype(int)\n",
        "print(classification_report(y_test, ensemble_preds))"
      ],
