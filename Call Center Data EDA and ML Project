      "source": [
        "## Experiment 1: New/Repeat Caller Split\n",
        "By isolating 'New Callers', we can identify which geographic or demographic signals drive conversions without being overshadowed by the `repeat_caller` flag. We will use the best parameters found during hyperparameter tuning."
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "2989059e",
        "outputId": "c4ca3e2d-490f-4dc5-a984-c5ef408ca0fc"
      },
      "source": [
        "from sklearn.metrics import roc_auc_score, classification_report\n",
        "\n",
        "# 1. Define cohorts for Training and Testing\n",
        "# New Callers (repeat_caller == 0)\n",
        "X_train_new = X_train[X_train['repeat_caller'] == 0].drop(columns=['repeat_caller'])\n",
        "y_train_new = y_train[X_train['repeat_caller'] == 0]\n",
        "X_test_new = X_test[X_test['repeat_caller'] == 0].drop(columns=['repeat_caller'])\n",
        "y_test_new = y_test[X_test['repeat_caller'] == 0]\n",
        "\n",
        "# Repeat Callers (repeat_caller == 1)\n",
        "X_train_repeat = X_train[X_train['repeat_caller'] == 1].drop(columns=['repeat_caller'])\n",
        "y_train_repeat = y_train[X_train['repeat_caller'] == 1]\n",
        "X_test_repeat = X_test[X_test['repeat_caller'] == 1].drop(columns=['repeat_caller'])\n",
        "y_test_repeat = y_test[X_test['repeat_caller'] == 1]\n",
        "\n",
        "def run_stratified_experiment(X_tr, y_tr, X_te, y_te, cohort_name):\n",
        "    print(f\"--- {cohort_name} Cohort ---\")\n",
        "    print(f\"Samples: {len(X_tr)} train / {len(X_te)} test\")\n",
        "\n",
        "    # Recalculate scale_pos_weight for this specific cohort balance\n",
        "    current_scale = (y_tr == 0).sum() / (y_tr == 1).sum()\n",
        "\n",
        "    # Initialize models with tuned hyperparameters\n",
        "    xgb_exp = XGBClassifier(**grid_xgb.best_params_, scale_pos_weight=current_scale, random_state=42, eval_metric='logloss')\n",
        "    rf_exp = RandomForestClassifier(**grid_rf.best_params_, class_weight='balanced', random_state=42, n_jobs=-1)\n",
        "\n",
        "    # Fit\n",
        "    xgb_exp.fit(X_tr, y_tr)\n",
        "    rf_exp.fit(X_tr, y_tr)\n",
        "\n",
        "    # Eval\n",
        "    xgb_auc = roc_auc_score(y_te, xgb_exp.predict_proba(X_te)[:, 1])\n",
        "    rf_auc = roc_auc_score(y_te, rf_exp.predict_proba(X_te)[:, 1])\n",
        "\n",
        "    print(f\"XGBoost ROC-AUC: {xgb_auc:.4f}\")\n",
        "    print(f\"Random Forest ROC-AUC: {rf_auc:.4f}\\n\")\n",
        "\n",
        "    return xgb_exp, rf_exp\n",
        "\n",
        "# Execute Experiment\n",
        "models_new = run_stratified_experiment(X_train_new, y_train_new, X_test_new, y_test_new, \"New Callers\")\n",
        "models_repeat = run_stratified_experiment(X_train_repeat, y_train_repeat, X_test_repeat, y_test_repeat, \"Repeat Callers\")"
