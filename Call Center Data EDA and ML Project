        "import hashlib\n",
        "import re\n",
        "\n",
        "def normalize_text(name):\n",
        "    if pd.isna(name) or str(name).lower() == 'nan':\n",
        "        return 'unknown'\n",
        "    # Lowercase, remove special characters, and strip common suffixes\n",
        "    s = str(name).lower()\n",
        "    s = re.sub(r'[^a-z0-9 ]', ' ', s)\n",
        "    s = re.sub(r'\\b(llc|inc|corp|svr|nsr|port|communications|services|wireless|pcs)\\b', '', s)\n",
        "    return ' '.join(s.split())\n",
        "\n",
        "\n",
        "def sha256_to_bits(text, n_bits=20):\n",
        "    \"\"\"Generates n binary features from a string using SHA-256.\"\"\"\n",
        "    hash_hex = hashlib.sha256(str(text).encode('utf-8')).hexdigest()\n",
        "    hash_int = int(hash_hex, 16)\n",
        "    return [int(x) for x in bin(hash_int)[2:2+n_bits].zfill(n_bits)]\n",
        "\n",
        "# We use the original dataframe 'df'\n",
        "if 'telnyx_carrier' in df.columns:\n",
        "    # 1. Create normalization mapping for visibility\n",
        "    unique_carriers = df[['telnyx_carrier']].drop_duplicates().copy()\n",
        "    unique_carriers['normalized'] = unique_carriers['telnyx_carrier'].apply(normalize_text)\n",
        "\n",
        "    print(\"--- Normalization Sample (Original vs Normalized) ---\")\n",
        "    display(unique_carriers.head(15))\n",
        "\n",
        "    # 2. Apply normalization to the main dataframe\n",
        "    df['telnyx_carrier_normalized'] = df['telnyx_carrier'].apply(normalize_text)\n",
        "\n",
        "    # 3. Apply the SHA-256 hashing\n",
        "    print(\"\\nHashing normalized carriers using SHA-256...\")\n",
        "    bit_features = df['telnyx_carrier_normalized'].apply(lambda x: sha256_to_bits(x, 20)).tolist()\n",
        "    carrier_hashed_df = pd.DataFrame(bit_features, columns=[f'carrier_sha_{i}' for i in range(20)])\n",
        "\n",
        "    # Collision metrics\n",
        "    unique_carriers_orig = df['telnyx_carrier'].nunique()\n",
        "    unique_carriers_norm = df['telnyx_carrier_normalized'].nunique()\n",
        "    unique_hashes = carrier_hashed_df.drop_duplicates().shape[0]\n",
        "\n",
        "    print(f\"Unique original carriers: {unique_carriers_orig}\")\n",
        "    print(f\"Unique normalized carriers: {unique_carriers_norm}\")\n",
        "    print(f\"Unique hashed representations: {unique_hashes}\")\n",
        "\n",
        "    # Reset index and merge\n",
        "    df = pd.concat([df.reset_index(drop=True), carrier_hashed_df], axis=1)\n",
        "\n",
        "    # Drop original and intermediate columns\n",
        "    df = df.drop(columns=['telnyx_carrier', 'telnyx_carrier_normalized'])\n",
        "\n",
        "print(\"\\nEncoded 'telnyx_carrier' into 20 binary features.\")\n",
        "display(df[[f'carrier_sha_{i}' for i in range(20)]].head())"
      ],
