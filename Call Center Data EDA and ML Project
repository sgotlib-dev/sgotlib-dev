      "cell_type": "code",
      "source": [
        "import numpy as np\n",
        "\n",
        "# 1. Ensure FIP codes are cleaned (5-digit string format)\n",
        "df_training['fip_clean'] = df_training['fip'].astype(str).str.split('.').str[0].str.zfill(5)\n",
        "\n",
        "# 2. Calculate the physical centroid for each FIPS code based on its component ZIP codes\n",
        "# We use the zip_lat and zip_lon columns created in the previous cell\n",
        "fips_geo_map = df_training.groupby('fip_clean').agg({\n",
        "    'zip_lat': 'mean',\n",
        "    'zip_lon': 'mean'\n",
        "}).to_dict('index')\n",
        "\n",
        "# 3. Map the FIPS centroids back to the training set as fip_lat and fip_lon\n",
        "df_training['fip_lat'] = df_training['fip_clean'].map(lambda x: fips_geo_map.get(x, {}).get('zip_lat', np.nan))\n",
        "df_training['fip_lon'] = df_training['fip_clean'].map(lambda x: fips_geo_map.get(x, {}).get('zip_lon', np.nan))\n",
        "\n",
        "# 4. Handle missing values for FIPS that had no valid ZIP coordinate data\n",
        "df_training['fip_lat'] = df_training['fip_lat'].fillna(df_training['fip_lat'].mean())\n",
        "df_training['fip_lon'] = df_training['fip_lon'].fillna(df_training['fip_lon'].mean())\n",
        "\n",
        "# 5. Clean up the temporary fip_clean helper column\n",
        "df_training = df_training.drop(columns=['fip_clean', 'fip'])\n",
        "\n",
        "print(\"FIPS coordinates (fip_lat, fip_lon) successfully generated.\")\n",
        "display(df_training[['fip_lat', 'fip_lon']].head())"
