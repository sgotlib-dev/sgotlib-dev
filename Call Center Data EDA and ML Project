    {
      "cell_type": "code",
      "source": [
        "bucket_counts=16\n",
        "def hash_segment_code(text, n_bits=bucket_counts):\n",
        "    \"\"\"Generates n binary features from a string using SHA-256.\"\"\"\n",
        "    if pd.isna(text) or text == 'nan':\n",
        "        return [0] * n_bits\n",
        "    hash_hex = hashlib.sha256(str(text).encode('utf-8')).hexdigest()\n",
        "    hash_int = int(hash_hex, 16)\n",
        "    return [int(x) for x in bin(hash_int)[2:2+n_bits].zfill(n_bits)]\n",
        "\n",
        "# 2. Normalize: Ensure they are strings and strip any '.0' or whitespace\n",
        "df_training['neustar_segment_code_norm'] = df_training['neustar_segment_code'].astype(str).str.replace('.0', '', regex=False).str.strip()\n",
        "\n",
        "# 3. Apply Hashing\n",
        "print(\"Hashing neustar_segment_code into binary features...\")\n",
        "seg_bit_features = df_training['neustar_segment_code_norm'].apply(lambda x: hash_segment_code(x, bucket_counts)).tolist()\n",
        "seg_hashed_df = pd.DataFrame(seg_bit_features, columns=[f'seg_sha_{i}' for i in range(bucket_counts)])\n",
        "\n",
        "# 4. Concatenate and cleanup\n",
        "df_training = pd.concat([df_training.reset_index(drop=True), seg_hashed_df], axis=1)\n",
        "df_training = df_training.drop(columns=['neustar_segment_code_norm'])\n",
        "\n",
        "display(df_training[[f'seg_sha_{i}' for i in range(bucket_counts)]].head())"
