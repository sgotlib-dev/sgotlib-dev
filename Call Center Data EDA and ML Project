        "import numpy as np\n",
        "\n",
        "# 1. Create the combined NPA-NXX feature\n",
        "df_training['npa_nxx'] = df_training['npa'].astype(str) + '-' + df_training['nxx'].astype(str)\n",
        "\n",
        "# 2. Ground the NPA-NXX in real space by calculating the mean ZIP coordinate for each pair\n",
        "# This uses the real-world zip_lat/lon we calculated to find the 'center' of each exchange\n",
        "npa_nxx_geo_map = df_training.groupby('npa_nxx').agg({\n",
        "    'zip_lat': 'mean',\n",
        "    'zip_lon': 'mean'\n",
        "}).to_dict('index')\n",
        "\n",
        "# 3. Apply the grounded projection\n",
        "df_training['npa_nxx_lat'] = df_training['npa_nxx'].map(lambda x: npa_nxx_geo_map.get(x, {}).get('zip_lat', np.nan))\n",
        "df_training['npa_nxx_lon'] = df_training['npa_nxx'].map(lambda x: npa_nxx_geo_map.get(x, {}).get('zip_lon', np.nan))\n",
        "\n",
        "# 4. Fill any remaining holes (where NPA-NXX didn't have a valid ZIP) with global mean\n",
        "df_training['npa_nxx_lat'] = df_training['npa_nxx_lat'].fillna(df_training['npa_nxx_lat'].mean())\n",
        "df_training['npa_nxx_lon'] = df_training['npa_nxx_lon'].fillna(df_training['npa_nxx_lon'].mean())\n",
