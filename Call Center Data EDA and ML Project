      "source": [
        "import pandas as pd\n",
        "import numpy as np\n",
        "\n",
        "# 1. Identify Low Variance Features (Constant or near-constant)\n",
        "# We look for features where the vast majority of values are the same\n",
        "from sklearn.feature_selection import VarianceThreshold\n",
        "\n",
        "selector = VarianceThreshold(threshold=(.99 * (1 - .99))) # Features that are 99% the same\n",
        "selector.fit(X)\n",
        "low_variance_cols = X.columns[~selector.get_support()]\n",
        "\n",
        "print(f\"--- Noise Analysis Report ---\")\n",
        "print(f\"Low Variance Features (Signal < 1%): {list(low_variance_cols)}\")\n",
        "\n",
        "# 2. Identify High Redundancy (Multicollinearity)\n",
        "# We look for features correlated at |r| > 0.9\n",
        "corr_matrix = X.corr().abs()\n",
        "upper = corr_matrix.where(np.triu(np.ones(corr_matrix.shape), k=1).astype(bool))\n",
        "high_redundancy_pairs = [column for column in upper.columns if any(upper[column] > 0.90)]\n",
        "\n",
        "print(f\"Highly Redundant Features (|r| > 0.9): {high_redundancy_pairs}\")\n",
        "\n",
        "# 3. Detailed look at correlation for redundant pairs\n",
        "if high_redundancy_pairs:\n",
        "    redundant_info = []\n",
        "    for col in high_redundancy_pairs:\n",
        "        correlated_with = upper.index[upper[col] > 0.90].tolist()\n",
        "        for other in correlated_with:\n",
        "            redundant_info.append({'Feature A': col, 'Feature B': other, 'Correlation': upper.loc[other, col]})\n",
        "\n",
        "    display(pd.DataFrame(redundant_info))\n",
        "\n",
        "# 4. Feature Sparsity Check (Hashed features)\n",
        "# Check if some hash bits are extremely sparse\n",
        "bit_cols = [c for c in X.columns if 'sha_' in c]\n",
        "bit_counts = X[bit_cols].sum() / len(X)\n",
        "sparse_bits = bit_counts[bit_counts < 0.01].index.tolist()\n",
        "print(f\"Sparse Hash Bits (< 1% activation): {len(sparse_bits)} bits\")"
      ],
