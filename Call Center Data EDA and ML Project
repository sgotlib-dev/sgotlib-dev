        "outputId": "2a42a1ea-dc35-4d6d-9895-8dd50b4bde81"
      },
      "source": [
        "from sklearn.metrics import precision_score, recall_score, f1_score\n",
        "\n",
        "thresholds = np.linspace(0, 1, 101)\n",
        "results = []\n",
        "\n",
        "for t in thresholds:\n",
        "    preds = (ensemble_scores_prod > t).astype(int)\n",
        "    precision = precision_score(y_test, preds, zero_division=0)\n",
        "    recall = recall_score(y_test, preds, zero_division=0)\n",
        "    f1 = f1_score(y_test, preds, zero_division=0)\n",
        "    results.append({'threshold': t, 'precision': precision, 'recall': recall, 'f1': f1})\n",
        "\n",
        "df_thresholds = pd.DataFrame(results)\n",
        "\n",
        "# Find optimal F1\n",
        "best_f1_row = df_thresholds.loc[df_thresholds['f1'].idxmax()]\n",
        "# Find threshold for 30% Precision\n",
        "target_precision_row = df_thresholds[df_thresholds['precision'] >= 0.30].head(1)\n",
        "\n",
        "print(f\"--- Threshold Optimization Results ---\")\n",
        "print(f\"Max F1-Score: {best_f1_row['f1']:.4f} at Threshold {best_f1_row['threshold']:.2f}\")\n",
        "print(f\"Recall at Max F1: {best_f1_row['recall']:.4f}\")\n",
        "\n",
        "if not target_precision_row.empty:\n",
        "    print(f\"\\nTarget 30% Precision reached at Threshold: {target_precision_row['threshold'].values[0]:.2f}\")\n",
        "    print(f\"Recall at 30% Precision: {target_precision_row['recall'].values[0]:.4f}\")\n",
        "else:\n",
        "    print(\"\\nTarget 30% Precision not achievable with current model.\")\n",
        "\n",
        "# Plot the trade-offs\n",
        "plt.figure(figsize=(10, 6))\n",
        "plt.plot(df_thresholds['threshold'], df_thresholds['precision'], label='Precision', color='teal')\n",
        "plt.plot(df_thresholds['threshold'], df_thresholds['recall'], label='Recall', color='darkorchid')\n",
        "plt.plot(df_thresholds['threshold'], df_thresholds['f1'], label='F1-Score', color='crimson', linestyle='--')\n",
        "plt.axvline(best_f1_row['threshold'], color='black', alpha=0.5, linestyle=':', label='Best F1')\n",
        "plt.title('Threshold Optimization: Precision, Recall, and F1')\n",
        "plt.xlabel('Probability Threshold')\n",
        "plt.ylabel('Score')\n",
        "plt.legend()\n",
        "plt.grid(True, alpha=0.3)\n",
