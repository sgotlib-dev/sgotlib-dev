      "source": [
        "\n",
        "# 1. Identify the top 4 DNIS values by frequency in the training set\n",
        "top_4_dnis = df_training['dnis'].value_counts().nlargest(4).index.tolist()\n",
        "\n",
        "# 2. Group all other DNIS values into 'Other'\n",
        "df_training['dnis_grouped'] = df_training['dnis'].astype(str).apply(lambda x: x if x in [str(i) for i in top_4_dnis] else 'Other')\n",
        "\n",
        "# 3. Apply One-Hot Encoding to the grouped DNIS column\n",
        "dnis_dummies = pd.get_dummies(df_training['dnis_grouped'], prefix='dnis')\n",
        "df_training = pd.concat([df_training, dnis_dummies], axis=1)\n",
        "\n",
        "# 4. Drop the original dnis and dnis_origin columns to avoid high cardinality and redundancy\n",
        "df_training = df_training.drop(columns=['dnis', 'dnis_origin', 'dnis_grouped'])\n",
        "\n",
        "print(f\"Grouped DNIS into: {top_4_dnis} + 'Other'\")\n",
        "print(f\"Added one-hot encoded columns: {dnis_dummies.columns.tolist()}\")\n",
        "print(f\"New shape of df_training: {df_training.shape}\")\n",
        "display(df_training.head())"
