      "source": [
        "import pgeocode\n",
        "\n",
        "# 1. Initialize US postal code database\n",
        "nomi = pgeocode.Nominatim('us')\n",
        "\n",
        "# 2. Clean and format the ZIP codes for lookup\n",
        "# Ensuring they are 5-digit strings\n",
        "zips = df_training['neustar_zip'].astype(str).str.split('.').str[0].str.zfill(5)\n",
        "\n",
        "# 3. Perform the spatial lookup\n",
        "unique_zips = zips.unique()\n",
        "geo_lookup = nomi.query_postal_code(unique_zips)\n",
        "\n",
        "# 4. Map coordinates back to the training set\n",
        "lat_map = dict(zip(geo_lookup['postal_code'], geo_lookup['latitude']))\n",
        "lon_map = dict(zip(geo_lookup['postal_code'], geo_lookup['longitude']))\n",
        "\n",
        "df_training['zip_lat'] = zips.map(lat_map)\n",
        "df_training['zip_lon'] = zips.map(lon_map)\n",
        "\n",
        "# 5. Handle missing values (invalid/missing zips) using the global centroid of the data\n",
        "df_training['zip_lat'] = df_training['zip_lat'].fillna(df_training['zip_lat'].mean())\n",
        "df_training['zip_lon'] = df_training['zip_lon'].fillna(df_training['zip_lon'].mean())\n",
        "\n",
        "# 6. Drop the simulated 'geo_lat/lon' and 'neustar_zip' to finalize the feature set\n",
        "# We keep 'zip_lat/lon' as the continuous spatial proxies\n",
        "cols_to_drop = ['geo_lat', 'geo_lon', 'neustar_zip']\n",
        "df_training = df_training.drop(columns=[c for c in cols_to_drop if c in df_training.columns])\n",
        "\n",
        "print(\"Upgraded to Real-World Geospatial Projection.\")\n",
        "display(df_training[['zip_lat', 'zip_lon']].head())"
      ],
